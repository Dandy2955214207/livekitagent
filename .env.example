# Local services; secrets are server-side only.
LIVEKIT_URL=ws://127.0.0.1:7880
# Optional browser-facing WSS URL; the mobile launcher sets this without changing backend routing.
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173

# Realtime provider: aliyun or yibuapi. Keys are isolated; no fallback between providers.
MODEL_PROVIDER=aliyun
YIBUAPI_API_KEY=
# yibuapi uses wss://yibuapi.com/v1/realtime; QWEN_MODEL/VOICE still select the Qwen model.
# Aliyun only: set the workspace ID and matching API key locally.
QWEN_REGION=cn-beijing
QWEN_WORKSPACE_ID=
QWEN_API_KEY=
# Leave empty to derive the workspace-specific URL from region and workspace ID.
QWEN_REALTIME_URL=
QWEN_MODEL=qwen3.8-omni-flash-realtime
QWEN_VOICE=Tina
# Used by the standalone provider probe.
QWEN_TURN_DETECTION=semantic_vad_ec
# Only the official Harness is supported. This setting is optional.
HARNESS_MODE=qwen_live_official
# Call memory uses the Aliyun workspace HTTP APIs for vision and text embeddings.
QWEN_LIVE_PROACTIVE_ENABLED=false
QWEN_LIVE_MEMORY_ENABLED=true
QWEN_MEMORY_VISION_MODEL=qwen3.5-flash
QWEN_MEMORY_EMBEDDING_MODEL=text-embedding-v4
QWEN_LIVE_MAX_GENERATIONS=80
QWEN_LIVE_MAX_MONITOR_GENERATIONS=60
QWEN_LIVE_MAX_CALL_SECONDS=600

AUDIO_INPUT_SAMPLE_RATE=16000
AUDIO_OUTPUT_SAMPLE_RATE=24000
VIDEO_FPS=1
VIDEO_MAX_WIDTH=640
VIDEO_MAX_HEIGHT=480
VIDEO_MAX_FRAME_AGE_MS=1500
LOG_LEVEL=INFO
RECORD_RAW_MEDIA=false

# Local LiveKit dispatch and session lifetime.
AGENT_NAME=qwen-voice-agent
WORKER_PORT=8081
SESSION_TTL_SECONDS=1800
JOIN_TIMEOUT_SECONDS=45
